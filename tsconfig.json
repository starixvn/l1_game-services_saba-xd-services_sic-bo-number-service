{
    "compilerOptions": {
        "outDir": "./build",
        "target": "ESNext",
        "types": [
            "node",
            "jest"
        ],
        "module": "ESNext",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules",
    ]
}